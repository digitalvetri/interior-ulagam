# Interior Studio OS — environment variable template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is git-ignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only — bypasses RLS; treat like a password
DATABASE_URL=                   # postgres connection string for Drizzle

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=          # System User token (long-lived)
WHATSAPP_VERIFY_TOKEN=          # you invent this; used for webhook handshake
WHATSAPP_APP_SECRET=            # to verify inbound X-Hub-Signature-256 header

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI ---
GROQ_API_KEY=                   # text/voice: Groq 120B/20B + Whisper v3 Turbo
GOOGLE_AI_API_KEY=              # vision: Gemini Flash for site photos

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Upstash Redis (rate limiting) ---
# Create a free Redis database at https://console.upstash.com
# Rate limiting is disabled gracefully when these are not set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Self-hosted stack (docker compose). The compose file injects these for the
# `app` container; set them here only when running `pnpm dev` on the host,
# pointing at the published host ports (5442 / 6389 / 9002).
# ---------------------------------------------------------------------------

# Postgres — container: postgres:5432, host: localhost:5442
DATABASE_URL=postgres://postgres:postgres@localhost:5442/interior_studio
DATABASE_POOL_MAX=10

# Redis — cache, rate limiting, and the BullMQ job queue
REDIS_URL=redis://localhost:6389

# MinIO (S3-compatible object storage) — replaces Supabase Storage
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Better Auth — signs session cookies. Generate with: openssl rand -base64 32
# Changing this invalidates every existing session.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
S3_QUOTES_BUCKET=quotes
# Browser-facing base URL for storage. Inside Docker the app reaches MinIO at
# http://minio:9000, but presigned URLs and public links must point at an
# address the browser can resolve.
S3_PUBLIC_URL=http://localhost:9002
