# Infrastructure credentials for docker compose.
# Copy to .env (gitignored) and replace every value. Compose refuses to start
# if any of these are missing, rather than falling back to a known default.
#
#   cp .env.docker.example .env
#   # then generate real secrets:
#   openssl rand -base64 24

POSTGRES_USER=interioos
POSTGRES_PASSWORD=          # required — generate one
POSTGRES_DB=interior_studio

MINIO_ROOT_USER=interioos
MINIO_ROOT_PASSWORD=        # required — generate one, min 8 chars

# Public origin of the app. Used for BETTER_AUTH_URL and client-facing links.
APP_URL=http://localhost:3000

# Browser-facing base URL for object storage. Baked into the CSP at build time,
# so changing it requires a rebuild, not just a restart.
S3_PUBLIC_URL=http://localhost:9002

# Published host ports. In production use docker-compose.prod.yml, which stops
# publishing the database and storage ports altogether.
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003

WORKER_CONCURRENCY=5
CRON_TZ=Asia/Kolkata

# Required only by docker-compose.prod.yml (TLS via Caddy)
APP_DOMAIN=studio.example.com
ACME_EMAIL=you@example.com

# Backups (./data/backups)
BACKUP_HOUR_UTC=19          # 19:00 UTC = 00:30 IST
BACKUP_RETENTION_DAYS=14

# Application database role (least privilege; created by migration 0003)
APP_DB_PASSWORD=
