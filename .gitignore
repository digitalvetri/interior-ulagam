.next/
out/
build/

# Node
node_modules/
.pnp
.pnp.js

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
playwright-report/
test-results/

# Misc
.DS_Store

# Local seed/admin/smoke scripts (may contain hardcoded credentials — never commit).
# Migration scripts (apply-*.mjs) are safe (they read from .env.local) and ARE tracked.
scripts/smoke-*.mjs
scripts/probe-*.mjs
scripts/seed-*.mjs
scripts/create-*.mjs

# Workflow build artifacts
workflow-*.js
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Drizzle
# drizzle/meta/ is intentionally TRACKED: _journal.json records which migrations
# have been applied, and the snapshots are what `drizzle-kit generate` diffs
# against. Ignoring it would make a fresh clone regenerate migrations that
# already exist in the database.

# Docker local volumes and backups (backups hold full database dumps)
data/
