{
  "name": "interior-studio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "vitest": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "inngest-cli": "inngest-cli dev",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "db:psql": "docker compose exec postgres psql -U postgres -d interior_studio",
    "db:apply": "docker compose exec -T postgres psql -U postgres -d interior_studio -f"
  },
  "dependencies": {
